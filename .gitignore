**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ============================================================
# 🔐 SENSITIVE / SECRET FILES — DO NOT COMMIT
# ============================================================

# Firebase config files (contain API keys)
# Regenerate with: flutterfire configure
lib/firebase_options.dart

# Android Firebase config (download from Firebase Console)
android/app/google-services.json

# iOS Firebase config (download from Firebase Console)
ios/Runner/GoogleService-Info.plist

# Android local machine paths (auto-generated per developer)
android/local.properties

# FCM Backend — root folder (has its own separate .git repo)
# The Flutter app only needs the Railway URL, not the source
fcm-backend/
lib/fcm-Backend/

# Environment variable files
.env
.env.local
.env.production
.env.*

# Debug log files
flutter_*.log
